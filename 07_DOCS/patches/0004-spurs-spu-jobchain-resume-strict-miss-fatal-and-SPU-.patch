+static inline void jg_unlock(void) { pthread_mutex_unlock(&s_jg_mtx); }
+static inline void jg_wake_all(void) { pthread_cond_broadcast(&s_jg_cv); }
+static inline void jg_wait_ms(unsigned ms)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_sec += ms / 1000u;
+    ts.tv_nsec += (long)(ms % 1000u) * 1000000L;
+    if (ts.tv_nsec >= 1000000000L) { ts.tv_sec++; ts.tv_nsec -= 1000000000L; }
+    pthread_cond_timedwait(&s_jg_cv, &s_jg_mtx, &ts);
+}
