+s32 _cellSpursLFQueuePushBody(u64 queue_ea, u64 data_ea, u32 isBlocking)
+{
+    if (!queue_ea || !data_ea) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+
+    uint32_t q   = (uint32_t)queue_ea;
+    uint32_t sz  = vm_read32(q + 0x10);
+    uint32_t dep = vm_read32(q + 0x14);
+    uint32_t buf = (uint32_t)vm_read64(q + 0x18);
+    if (!sz || !dep || !buf) return CELL_SPURS_TASK_ERROR_INVAL;
+
+    u16 pop1 = 0, push1 = 0, next_push1 = 0;
+    u32 slot = 0;
+    int wait_spins = 0;
+    int64_t wait_t0 = 0;
+    for (;;) {
+        spu_lockline_lock();
+        pop1  = ef_r16(q + 0x06);
+        push1 = ef_r16(q + 0x08);
+        u32 occ = (push1 >= pop1) ? (u32)(push1 - pop1)
+                                  : (u32)(push1 + 2u * dep - pop1);
+        if (occ < dep) {
+            slot = (u32)(push1 % dep);
+            memcpy(vm_base + buf + (size_t)slot * sz,
+                   vm_base + (uint32_t)data_ea, sz);
+            next_push1 = (u16)((push1 + 1u) % (2u * dep));
+            ef_w16(q + 0x08, next_push1);
+            ef_line_end(q);
+            break;
+        }
+        spu_lockline_unlock();
+        if (!isBlocking) return (s32)0x80410901u; /* CELL_SYNC_ERROR_AGAIN */
+        spurs_queue_wait_step(&wait_spins, &wait_t0);
+    }
+
+    extern int spu_taskset_signal_by_obj(uint32_t wait_obj);
+    int woke = spu_taskset_signal_by_obj(q);
+
+    static int _n = 0;
+    if (PS3_LOG_FIRST(_n, 16))
+        fprintf(stderr, "[cellSpurs] _LFQueuePushBody q=0x%08X slot=%u push=%u->%u pop=%u sz=%u dep=%u woke=%d\n",
+                q, slot, (unsigned)push1, (unsigned)next_push1, (unsigned)pop1, sz, dep, woke);
+    return CELL_OK;
+}
