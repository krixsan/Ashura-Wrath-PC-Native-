+static inline uint32_t hle_be32_read(const uint8_t* p) {
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+           ((uint32_t)p[2] << 8)  | (uint32_t)p[3];
+}
+static inline void hle_be32_write(uint8_t* p, uint32_t v) {
+    p[0] = (uint8_t)(v >> 24);
+    p[1] = (uint8_t)(v >> 16);
+    p[2] = (uint8_t)(v >> 8);
+    p[3] = (uint8_t)(v);
+}
+
+static int hle_mp3_parse_hdr(const uint8_t* p, uint32_t* out_sr, uint32_t* out_ch,
+                             uint32_t* out_kbps, uint32_t* out_samples, uint32_t* out_flen) {
+    static const uint16_t m1_br[16] = {0,32,40,48,56,64,80,96,112,128,160,192,224,256,320,0};
+    static const uint16_t m2_br[16] = {0, 8,16,24,32,40,48,56, 64, 80, 96,112,128,144,160,0};
+    static const uint16_t sr_t[3]   = {44100, 48000, 32000};
+    uint32_t h = hle_be32_read(p);
+    if ((h & 0xFFE00000u) != 0xFFE00000u) return 0;
+    uint32_t ver    = (h >> 19) & 3u;
+    uint32_t layer  = (h >> 17) & 3u;
+    uint32_t br_idx = (h >> 12) & 15u;
+    uint32_t sr_idx = (h >> 10) & 3u;
+    uint32_t pad    = (h >> 9)  & 1u;
+    uint32_t mode   = (h >> 6)  & 3u;
+    if (ver == 1u || layer != 1u || br_idx == 0u || br_idx == 15u || sr_idx == 3u) return 0;
+    uint32_t sr, kbps, samples, flen;
+    if (ver == 3u) {
+        sr = sr_t[sr_idx];
+        kbps = m1_br[br_idx];
+        samples = 1152u;
+        flen = (144000u * kbps) / sr + pad;
+    } else {
+        sr = sr_t[sr_idx] >> (ver == 0u ? 2u : 1u);
+        kbps = m2_br[br_idx];
+        samples = 576u;
+        flen = (72000u * kbps) / sr + pad;
+    }
+    if (flen < 4u || flen > 2048u) return 0;
+    *out_sr = sr;
+    *out_ch = (mode == 3u) ? 1u : 2u;
+    *out_kbps = kbps;
+    *out_samples = samples;
+    *out_flen = flen;
+    return 1;
+}
+
+static int hle_acm_ensure(void) {
+    if (s_acm_ready) return s_acm_ready > 0;
+    AcquireSRWLockExclusive(&s_mp3_pool_lock);
+    if (!s_acm_ready) {
+        HMODULE h = LoadLibraryA("msacm32.dll");
+        if (h) {
+            s_acmOpen   = (pfn_acmStreamOpen)GetProcAddress(h, "acmStreamOpen");
+            s_acmClose  = (pfn_acmStreamClose)GetProcAddress(h, "acmStreamClose");
+            s_acmPrep   = (pfn_acmStreamPrepareHeader)GetProcAddress(h, "acmStreamPrepareHeader");
+            s_acmUnprep = (pfn_acmStreamUnprepareHeader)GetProcAddress(h, "acmStreamUnprepareHeader");
+            s_acmConv   = (pfn_acmStreamConvert)GetProcAddress(h, "acmStreamConvert");
+            s_acm_ready = (s_acmOpen && s_acmClose && s_acmPrep && s_acmUnprep && s_acmConv) ? 1 : -1;
+        } else {
+            s_acm_ready = -1;
+        }
+        if (s_acm_ready < 0)
+            fprintf(stderr, "[spu] flashMP3 HLE: msacm32.dll unavailable\n");
+    }
+    ReleaseSRWLockExclusive(&s_mp3_pool_lock);
+    return s_acm_ready > 0;
+}
+
+static spu_mp3_slot_t* hle_mp3_get_slot(uint8_t* state_ls, uint32_t* out_gen) {
+    AcquireSRWLockExclusive(&s_mp3_pool_lock);
+    uint32_t magic = hle_be32_read(state_ls);
+    uint32_t slot  = hle_be32_read(state_ls + 4);
+    uint32_t gen   = hle_be32_read(state_ls + 8);
+    if (magic == SPU_MP3_MAGIC && slot < SPU_MP3_SLOTS && gen != 0u &&
+        s_mp3_slots[slot].gen == gen) {
+        *out_gen = gen;
+        ReleaseSRWLockExclusive(&s_mp3_pool_lock);
+        return &s_mp3_slots[slot];
+    }
+    uint32_t pick = SPU_MP3_SLOTS;
+    for (uint32_t i = 0; i < SPU_MP3_SLOTS; i++) {
+        if (s_mp3_slots[i].gen == 0u) { pick = i; break; }
+    }
+    if (pick == SPU_MP3_SLOTS) {
+        pick = (s_mp3_evict_idx++) % SPU_MP3_SLOTS;
+    }
+    uint32_t new_gen = s_mp3_next_gen++;
+    if (new_gen == 0u) new_gen = s_mp3_next_gen++;
+    s_mp3_slots[pick].gen = new_gen;
+    hle_be32_write(state_ls + 0, SPU_MP3_MAGIC);
+    hle_be32_write(state_ls + 4, pick);
+    hle_be32_write(state_ls + 8, new_gen);
+    *out_gen = new_gen;
+    ReleaseSRWLockExclusive(&s_mp3_pool_lock);
+    return &s_mp3_slots[pick];
+}
