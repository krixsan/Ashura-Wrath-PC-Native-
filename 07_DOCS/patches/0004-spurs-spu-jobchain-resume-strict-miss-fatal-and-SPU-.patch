+++ b/tests/test_spurs_jobchain_end_resume.c
@@ -0,0 +1,151 @@
+/* SPURS jobchain END cursor persistence and concurrent kick handshake.
+ * Manufactured job descriptors only -- no game code or data. */
+#define spu_workload_dispatch_job fixture_dispatch_job
+#include "../libs/spurs/cellSpurs.c"
+#undef spu_workload_dispatch_job
+#include <assert.h>
+#include <stdatomic.h>
+#include "../runtime/spu/spu_coherency.h"
+
+void spu_indirect_branch(spu_context*);
+void spu_halt(spu_context*);
+uint8_t* vm_base;
+uint32_t ppu_vm_size = 0x20000;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi, g_barrier_sync_watch;
+uint32_t g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
+unsigned long long ps3_ms_now(void) {
+    LARGE_INTEGER n, f;
+    QueryPerformanceCounter(&n);
+    QueryPerformanceFrequency(&f);
+    return (unsigned long long)(n.QuadPart * 1000 / f.QuadPart);
+}
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int sys_event_queue_push_by_id(uint32_t q, uint64_t s, uint64_t d1, uint64_t d2, uint64_t d3) {
+    (void)q; (void)s; (void)d1; (void)d2; (void)d3; return 0;
+}
+void sys_event_queue_cancel_by_id(u32 id) { (void)id; }
+void sys_event_queue_uncancel_by_id(u32 id) { (void)id; }
+int64_t sys_event_flag_create_host(uint32_t id_out, uint64_t init_pattern) {
+    (void)id_out; (void)init_pattern; return 0;
+}
+void spurs_taskset_init(uint32_t taskset_ea, uint32_t spurs_ea, uint64_t args,
+                        uint32_t wid, uint32_t size, uint32_t evf1, uint32_t evf2) {
+    (void)taskset_ea; (void)spurs_ea; (void)args; (void)wid; (void)size; (void)evf1; (void)evf2;
+}
+uint32_t spurs_taskset_take_slot(uint32_t taskset_ea, uint32_t max_tasks) {
+    (void)taskset_ea; (void)max_tasks; return 0;
+}
+void spurs_taskset_add_task(uint32_t taskset_ea, uint32_t taskId, uint64_t elf_ea,
+                            uint64_t context, const uint32_t arg[4],
+                            const uint32_t ls_pattern[4]) {
+    (void)taskset_ea; (void)taskId; (void)elf_ea; (void)context; (void)arg; (void)ls_pattern;
+}
+void ydkj_wake_all_event_flags(void) {}
+uint64_t spurs_pm_build_context(uint8_t* ls, uint32_t a, uint32_t b, uint32_t c, uint32_t d) {
+    (void)ls; (void)a; (void)b; (void)c; (void)d; return 0;
+}
+void spu_thread_publish_ctx(uint32_t tid, void* ctx) { (void)tid; (void)ctx; }
+
+enum {
+    CMD_LIST_EA  = 0x2000,
+    JC_EA        = 0x1800,
+    BIN_EA       = 0x9000,
+    SPURS_JOB_END = 7 | (15 << 3),
+};
+
+static atomic_uint run_count;
+static atomic_uint entered_4200;
+static atomic_uint release_4200;
+static uint32_t run_history[8];
+
+int fixture_dispatch_job(const uint8_t* image, uint32_t image_size,
+                         uint32_t job_ea, uint32_t job_desc_size)
+{
+    (void)image; (void)image_size; (void)job_desc_size;
+    if (job_ea == 0x4200) {
+        atomic_store(&entered_4200, 1);
+        for (unsigned i = 0; i < 3000 && !atomic_load(&release_4200); i++)
+            Sleep(1);
+        assert(atomic_load(&release_4200) && "timeout waiting to release job 0x4200");
+    }
+    unsigned idx = atomic_fetch_add(&run_count, 1);
+    assert(idx < 8);
+    run_history[idx] = job_ea;
+    return 0;
+}
+
+static void write_job_desc(u32 job_ea)
+{
+    vm_write64(job_ea + JH_EA_BINARY, BIN_EA);
+    vm_write32(job_ea + JH_SIZE_BINARY, 1u << 16); /* size = 16 bytes */
+}
+
+static void wait_flag(atomic_uint* flag, unsigned want, const char* what)
+{
+    for (unsigned i = 0; i < 3000; i++) {
+        if (atomic_load(flag) >= want) return;
+        Sleep(1);
+    }
+    fprintf(stderr, "FAIL: timeout waiting for %s\n", what);
+    exit(1);
+}
+
+int main(void)
+{
+    vm_base = (uint8_t*)calloc(1, ppu_vm_size);
+    assert(vm_base);
+    memset(vm_base + BIN_EA, 0x11, 16);
+
+    write_job_desc(0x4000);
+    write_job_desc(0x4100);
+    write_job_desc(0x4200);
+    write_job_desc(0x4300);
+
+    /* Initial chain: JOB(0x4000), END */
+    vm_write64(CMD_LIST_EA + 0x00, 0x4000);
+    vm_write64(CMD_LIST_EA + 0x08, SPURS_JOB_END);
+
+    assert(cellSpursCreateJobChain(0x1000, JC_EA, CMD_LIST_EA, 128, 1, 0, 1, 0) == CELL_OK);
+    assert(cellSpursRunJobChain(JC_EA) == CELL_OK);
+    wait_flag(&run_count, 1, "initial job 0x4000");
+    assert(cellSpursJoinJobChain(JC_EA) == CELL_OK);
+    assert(atomic_load(&run_count) == 1);
+    assert(run_history[0] == 0x4000);
+
+    /* Guest replaces END with JOB(0x4100), followed by a new END, then kicks.
+     * Execution must resume at CMD_LIST_EA+0x08 rather than re-running 0x4000. */
+    vm_write64(CMD_LIST_EA + 0x08, 0x4100);
+    vm_write64(CMD_LIST_EA + 0x10, SPURS_JOB_END);
+    assert(cellSpursKickJobChain(JC_EA, 1) == CELL_OK);
+    wait_flag(&run_count, 2, "resumed job 0x4100");
+    assert(cellSpursJoinJobChain(JC_EA) == CELL_OK);
+    assert(atomic_load(&run_count) == 2);
+    assert(run_history[0] == 0x4000 && run_history[1] == 0x4100);
+    puts("SPURS jobchain END cursor persistence PASS");
+
+    /* Concurrent kick while active: queue JOB(0x4200), hold inside it while
+     * appending JOB(0x4300) and kicking again before the walker reaches END. */
+    vm_write64(CMD_LIST_EA + 0x10, 0x4200);
+    vm_write64(CMD_LIST_EA + 0x18, SPURS_JOB_END);
+    assert(cellSpursKickJobChain(JC_EA, 1) == CELL_OK);
+    wait_flag(&entered_4200, 1, "walker inside job 0x4200");
+
+    vm_write64(CMD_LIST_EA + 0x18, 0x4300);
+    vm_write64(CMD_LIST_EA + 0x20, SPURS_JOB_END);
+    assert(cellSpursKickJobChain(JC_EA, 1) == CELL_OK);
+    atomic_store(&release_4200, 1);
+
+    wait_flag(&run_count, 4, "concurrently kicked job 0x4300");
+    assert(cellSpursJoinJobChain(JC_EA) == CELL_OK);
+    assert(atomic_load(&run_count) == 4);
+    assert(run_history[2] == 0x4200 && run_history[3] == 0x4300);
+    puts("SPURS jobchain concurrent kick handshake PASS");
+
+    assert(cellSpursShutdownJobChain(JC_EA) == CELL_OK);
+    assert(cellSpursJoinJobChain(JC_EA) == CELL_OK);
+    free(vm_base);
+    return 0;
+}
+
