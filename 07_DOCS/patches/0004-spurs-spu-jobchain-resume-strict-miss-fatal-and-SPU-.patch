+/* SDK ABI: cellSpursQueuePopBody(CellSpursQueue*, void* buf, unsigned int* size, bool isBlocking) */
+s32 cellSpursQueuePopBody(u64 queue_ea, u64 data_ea, u64 size_ea, u32 isBlocking)
+{
+    static int _n = 0;
+    if (PS3_LOG_FIRST(_n, 8))
+        printf("[cellSpurs] QueuePopBody(q=0x%08X, data=0x%08X, size=0x%08X, block=%u)\n",
+               (u32)queue_ea, (u32)data_ea, (u32)size_ea, isBlocking);
+
+    if (!queue_ea || !data_ea) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if (queue_ea & 0x7Fu)      return CELL_SPURS_TASK_ERROR_ALIGN;
+
+    uint32_t q   = (uint32_t)queue_ea;
+    uint32_t sz  = vm_read32(q + 0x10);
+    uint32_t dep = vm_read32(q + 0x14);
+    uint32_t buf = (uint32_t)vm_read64(q + 0x18);
+    if (!sz || !dep || !buf) return CELL_SPURS_TASK_ERROR_INVAL;
+
+    int32_t mod = (int32_t)vm_read32(q + 0x0C);
+    if (mod <= 0) mod = (int32_t)dep;
+
+    int wait_spins = 0;
+    int64_t wait_t0 = 0;
+    for (;;) {
+        int32_t w0 = (int32_t)vm_read32(q + 0x00);
+        int32_t w1 = (int32_t)vm_read32(q + 0x04);
+        int32_t cur_pop  = (w0 < 0) ? ~w0 : w0;
+        int32_t cur_push = (w1 < 0) ? ~w1 : w1;
+        if (cur_pop != cur_push) {
+            uint32_t slot = (uint32_t)(cur_pop % mod);
+            memcpy(vm_base + (uint32_t)data_ea,
+                   vm_base + buf + (uint64_t)slot * sz, sz);
+            int32_t nxt = (cur_pop + 1) % (2 * mod);
+            vm_write32(q + 0x00, (uint32_t)nxt);
+            if (size_ea) vm_write32((uint32_t)size_ea, sz);
+            return CELL_OK;
+        }
+        if (!isBlocking)
+            return (s32)CELL_SPURS_TASK_ERROR_AGAIN;
+        {
+            uint32_t se = (uint32_t)vm_read64(q + 0x70);
+            const struct SpursInst* si = spurs_inst_find(se);
+            if (si && si->stopping)
+                return (s32)CELL_SPURS_TASK_ERROR_AGAIN;
+        }
+        spurs_queue_wait_step(&wait_spins, &wait_t0);
+    }
+}
