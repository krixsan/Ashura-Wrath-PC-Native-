+#!/usr/bin/env python3
+"""SPURS jobchain END cursor persistence and concurrent kick handshake."""
+import os
+import platform
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[1]
+units = ['spu_channels', 'spu_drain', 'spu_lockstep', 'spu_coherency', 'spu_workload',
+         'spurs_policy', 'spurs_job', 'spu_tsp_weak', 'spu_vm_pagemap',
+         'spurs_policy_blob_weak', 'spu_interp']
+
+with tempfile.TemporaryDirectory(prefix='spurs-jc-end-resume-') as tmp:
+    tmpp = Path(tmp)
+    if os.name == 'nt':
+        sys.path.insert(0, str(root / 'tools'))
+        from msvc_env import environ
+        env = environ()
+        cc = shutil.which('clang-cl', path=env.get('PATH'))
+        if not cc:
+            print('SKIP: clang-cl not found'); raise SystemExit(0)
+        out = tmpp / 'test.exe'
+        subprocess.run([
+            cc, '/nologo', '/std:c11', '/O1', '/UNDEBUG', '/D_CRT_SECURE_NO_WARNINGS',
+            '-I' + str(root / 'include'),
+            '-I' + str(root / 'runtime/spu'),
+            '-I' + str(root / 'runtime/platform'),
+            str(root / 'tests/test_spurs_jobchain_end_resume.c'),
+            *[str(root / 'runtime/spu' / f'{u}.c') for u in units],
+            '/Fe' + str(out), '/Fo' + str(tmpp) + '\\',
+        ], env=env, check=True)
+    else:
+        env = dict(os.environ)
+        out = tmpp / 'test'
+        subprocess.run([
+            env.get('CC', 'cc'), '-std=gnu17', '-D_GNU_SOURCE', '-O1', '-UNDEBUG',
+            '-ffunction-sections', '-fdata-sections',
+            '-Wl,-dead_strip' if platform.system() == 'Darwin' else '-Wl,--gc-sections',
+            '-I' + str(root / 'include'),
+            '-I' + str(root / 'runtime/spu'),
+            '-I' + str(root / 'runtime/platform'),
+            str(root / 'tests/test_spurs_jobchain_end_resume.c'),
+            *[str(root / 'runtime/spu' / f'{u}.c') for u in units],
+            str(root / 'runtime/platform/win32_compat.c'),
+            '-pthread', '-lm', '-o', str(out),
+        ], env=env, check=True)
+    subprocess.run([str(out)], env=env, check=True, timeout=15)
+
