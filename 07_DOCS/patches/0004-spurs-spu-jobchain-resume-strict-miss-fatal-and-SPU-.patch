+
+#define SPU_MP3_MAGIC 0x4D503331u /* "MP31" */
+#define SPU_MP3_SLOTS 16
+static spu_mp3_slot_t s_mp3_slots[SPU_MP3_SLOTS];
+static SRWLOCK        s_mp3_pool_lock = SRWLOCK_INIT;
+static uint32_t       s_mp3_next_gen  = 1;
+static uint32_t       s_mp3_evict_idx = 0;
