+    if (*t0_qpc == 0)
+        *t0_qpc = (int64_t)now.QuadPart;
+    if (((int64_t)now.QuadPart - *t0_qpc) < (s_qpf / 500LL)) {
+        SwitchToThread();
+        YieldProcessor();
+        return;
+    }
+    Sleep(1);
+#else
+    (void)spins;
+    (void)t0_qpc;
+    usleep(1000);
+#endif
+}
