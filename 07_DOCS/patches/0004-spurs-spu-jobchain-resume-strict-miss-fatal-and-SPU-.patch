+static inline void jg_lock(void)
+{
+    InitOnceExecuteOnce(&s_jg_once, jg_sync_init_cb, NULL, NULL);
+    EnterCriticalSection(&s_jg_cs);
+}
+static inline void jg_unlock(void) { LeaveCriticalSection(&s_jg_cs); }
+static inline void jg_wake_all(void)
+{
+    InitOnceExecuteOnce(&s_jg_once, jg_sync_init_cb, NULL, NULL);
+    WakeAllConditionVariable(&s_jg_cv);
+}
+static inline void jg_wait_ms(unsigned ms)
+{
+    SleepConditionVariableCS(&s_jg_cv, &s_jg_cs, (DWORD)ms);
+}
+#else
+static pthread_mutex_t s_jg_mtx = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t  s_jg_cv  = PTHREAD_COND_INITIALIZER;
