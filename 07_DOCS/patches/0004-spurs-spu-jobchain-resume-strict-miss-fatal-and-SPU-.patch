+/* HLE replacement for PS3 /dev_flash/sys/external/flashMP3.pic loaded at LS 0x1A900.
+ * ABI (observed in MultiStream SPU image 0x017AA900 @ 0x06B80..0x07340):
+ *   r3 = input MP3 stream ptr in LS (typically 0x32900..0x340FF), r4 = *consumed_bytes (BE u32),
+ *   r5 = *pcm_bytes_per_ch (BE u32), r6 = planar PCM out base (4096-byte stride, BE int16),
+ *   r9 = 4992-byte persistent stream state in LS. Return r3 = r6 (PCM ready), 0 (skip/no PCM), -1 (err). */
+static void spu_hle_mp3_decode(spu_context* ctx) {
+    uint32_t r3_ls = ctx->gpr[3]._u32[0] & SPU_LS_MASK;
+    uint32_t r4_ls = ctx->gpr[4]._u32[0] & SPU_LS_MASK;
+    uint32_t r5_ls = ctx->gpr[5]._u32[0] & SPU_LS_MASK;
+    uint32_t r6_ls = ctx->gpr[6]._u32[0] & SPU_LS_MASK;
+    uint32_t r9_ls = ctx->gpr[9]._u32[0] & SPU_LS_MASK;
+    uint32_t lr_ls = ctx->gpr[0]._u32[0] & SPU_LS_MASK;
+
+    if (r4_ls + 4u > (SPU_LS_MASK + 1u) || r5_ls + 4u > (SPU_LS_MASK + 1u) ||
+        r9_ls + 12u > (SPU_LS_MASK + 1u) || r6_ls + 8192u > (SPU_LS_MASK + 1u) ||
+        !hle_acm_ensure()) {
+        if (r4_ls + 4u <= (SPU_LS_MASK + 1u)) hle_be32_write(ctx->ls + r4_ls, 0u);
+        if (r5_ls + 4u <= (SPU_LS_MASK + 1u)) hle_be32_write(ctx->ls + r5_ls, 0u);
+        memset(&ctx->gpr[3], 0, sizeof(ctx->gpr[3]));
+        ctx->gpr[3]._u32[0] = 0xFFFFFFFFu;
+        ctx->pc = lr_ls;
+        return;
+    }
+
+    const uint8_t* in = ctx->ls + r3_ls;
+    uint32_t avail = (r3_ls >= 0x32900u && r3_ls < 0x34100u)
+                         ? (0x34100u - r3_ls)
+                         : ((SPU_LS_MASK + 1u) - r3_ls);
+    uint32_t off = 0u;
+    uint32_t out_samples = 0u;
+    uint32_t out_ch = 0u;
+    int      warmup_only = (lr_ls == 0x6E2Cu);
+
+    uint32_t slot_gen = 0u;
+    spu_mp3_slot_t* slot = hle_mp3_get_slot(ctx->ls + r9_ls, &slot_gen);
+    AcquireSRWLockExclusive(&slot->lock);
+
+    for (int pass = 0; pass < 2; pass++) {
+        /* Skip optional ID3v2 header at stream start */
+        if (off + 10u <= avail && in[off] == 'I' && in[off + 1] == 'D' && in[off + 2] == '3') {
+            uint32_t id3_sz = 10u + (((uint32_t)(in[off + 6] & 0x7Fu) << 21) |
+                                     ((uint32_t)(in[off + 7] & 0x7Fu) << 14) |
+                                     ((uint32_t)(in[off + 8] & 0x7Fu) << 7)  |
+                                     (uint32_t)(in[off + 9] & 0x7Fu));
+            if (off + id3_sz > avail) { off = avail; break; }
+            off += id3_sz;
+        }
+
+        uint32_t sr = 0, ch = 0, kbps = 0, samples = 0, flen = 0;
+        int found = 0;
+        while (off + 4u <= avail) {
+            if (hle_mp3_parse_hdr(in + off, &sr, &ch, &kbps, &samples, &flen)) {
+                /* When scanning forward past non-sync bytes, require next frame sync too if in bounds */
+                if (off == 0u || off + flen + 2u > avail ||
+                    (in[off + flen] == 0xFFu && (in[off + flen + 1u] & 0xE0u) == 0xE0u)) {
+                    found = 1;
+                    break;
+                }
+            }
+            off++;
+        }
+        if (!found) {
+            /* No sync header left in buffer (e.g. EOF zero pad) */
+            off = (avail > 3u && in[avail - 1] == 0) ? avail : (avail >= 3u ? avail - 3u : 0u);
+            break;
+        }
+        if (off + flen > avail) {
+            /* Split frame at buffer boundary: advance up to sync if off>0, else consume tail */
+            if (off == 0u) off = avail;
+            break;
+        }
+
+        if (!slot->has || slot->sr != sr || slot->ch != ch || slot->gen != slot_gen) {
+            if (slot->has) { s_acmClose(slot->has, 0); slot->has = NULL; }
+            MPEGLAYER3WAVEFORMAT mp3fmt;
+            memset(&mp3fmt, 0, sizeof(mp3fmt));
+            mp3fmt.wfx.wFormatTag      = WAVE_FORMAT_MPEGLAYER3;
+            mp3fmt.wfx.nChannels       = (WORD)ch;
+            mp3fmt.wfx.nSamplesPerSec  = (DWORD)sr;
+            mp3fmt.wfx.nAvgBytesPerSec = (DWORD)(kbps * 125u);
+            mp3fmt.wfx.nBlockAlign     = 1;
+            mp3fmt.wfx.wBitsPerSample  = 0;
+            mp3fmt.wfx.cbSize          = MPEGLAYER3_WFX_EXTRA_BYTES;
+            mp3fmt.wID                 = MPEGLAYER3_ID_MPEG;
+            mp3fmt.fdwFlags            = MPEGLAYER3_FLAG_PADDING_ISO;
+            mp3fmt.nBlockSize          = (WORD)flen;
+            mp3fmt.nFramesPerBlock     = 1;
+            mp3fmt.nCodecDelay         = 0;
+
+            WAVEFORMATEX pcmfmt;
+            memset(&pcmfmt, 0, sizeof(pcmfmt));
+            pcmfmt.wFormatTag      = WAVE_FORMAT_PCM;
+            pcmfmt.nChannels       = (WORD)ch;
+            pcmfmt.nSamplesPerSec  = (DWORD)sr;
+            pcmfmt.wBitsPerSample  = 16;
+            pcmfmt.nBlockAlign     = (WORD)(ch * 2u);
+            pcmfmt.nAvgBytesPerSec = (DWORD)(sr * pcmfmt.nBlockAlign);
+
+            MMRESULT mr = s_acmOpen(&slot->has, NULL, &mp3fmt.wfx, &pcmfmt, NULL, 0, 0, 0);
+            if (mr != 0) {
+                static int _err_log = 0;
+                if (PS3_LOG_FIRST(_err_log, 4))
+                    fprintf(stderr, "[spu] flashMP3 acmStreamOpen failed mmr=%u sr=%u ch=%u flen=%u\n",
+                            mr, sr, ch, flen);
+                slot->has = NULL;
+                break;
+            }
+            slot->sr = sr;
+            slot->ch = ch;
+            slot->gen = slot_gen;
+        }
+
+        uint8_t pcm_le[1152u * 2u * 2u];
+        ACMSTREAMHEADER ash;
+        memset(&ash, 0, sizeof(ash));
+        ash.cbStruct    = sizeof(ash);
+        ash.pbSrc       = (LPBYTE)(in + off);
+        ash.cbSrcLength = (DWORD)flen;
+        ash.pbDst       = pcm_le;
+        ash.cbDstLength = (DWORD)(samples * ch * 2u);
+
+        if (s_acmPrep(slot->has, &ash, 0) != 0) break;
+        MMRESULT cmr = s_acmConv(slot->has, &ash, 0);
+        uint32_t src_used = (uint32_t)ash.cbSrcLengthUsed;
+        uint32_t dst_used = (uint32_t)ash.cbDstLengthUsed;
+        s_acmUnprep(slot->has, &ash, 0);
+
+        if (cmr != 0) break;
+        off += (src_used > 0u) ? src_used : flen;
+
+        if (dst_used > 0u) {
+            out_samples = dst_used / (ch * 2u);
+            if (out_samples > samples) out_samples = samples;
+            out_ch = ch;
+            uint8_t* ch0 = ctx->ls + r6_ls;
+            uint8_t* ch1 = ctx->ls + r6_ls + 4096u;
+            if (ch == 2u) {
+                for (uint32_t i = 0; i < out_samples; i++) {
+                    ch0[i * 2u + 0u] = pcm_le[i * 4u + 1u];
+                    ch0[i * 2u + 1u] = pcm_le[i * 4u + 0u];
+                    ch1[i * 2u + 0u] = pcm_le[i * 4u + 3u];
+                    ch1[i * 2u + 1u] = pcm_le[i * 4u + 2u];
+                }
+            } else {
+                for (uint32_t i = 0; i < out_samples; i++) {
+                    uint8_t hi = pcm_le[i * 2u + 1u];
+                    uint8_t lo = pcm_le[i * 2u + 0u];
+                    ch0[i * 2u + 0u] = hi;
+                    ch0[i * 2u + 1u] = lo;
+                    ch1[i * 2u + 0u] = hi;
+                    ch1[i * 2u + 1u] = lo;
+                }
+            }
+            break;
+        }
+        /* Frame 0 lookahead yielded dst_used == 0: if Call 1 (warmup) return r6 so Call 2 runs next;
+         * if Call 2, feed Frame 1 in the same call so PCM emits without skipping a slot. */
+        if (warmup_only) { out_ch = ch; break; }
+    }
+
+    ReleaseSRWLockExclusive(&slot->lock);
+
+    uint32_t pcm_bytes = out_samples * 2u;
+    uint32_t ret = (out_samples > 0u || (warmup_only && out_ch > 0u && off > 0u)) ? r6_ls : 0u;
+    hle_be32_write(ctx->ls + r4_ls, off);
+    hle_be32_write(ctx->ls + r5_ls, pcm_bytes);
+    memset(&ctx->gpr[3], 0, sizeof(ctx->gpr[3]));
+    ctx->gpr[3]._u32[0] = ret;
+    ctx->pc = lr_ls;
+}
