  * written for host pointers and was never actually invoked until its NIDs
@@ -880,6 +960,7 @@ s32 cellPadGetData(u32 port_no, CellPadData* data_guest)
     /* Build in a local host struct, then copy to guest memory big-endian. */
     CellPadData _d; CellPadData* data = &_d;
     memset(data, 0, sizeof(CellPadData));
+    int diag_src_tag = 0; /* 0=host/kbd, 1=PAD_STICK, 2=PAD_SWEEP */
 
     /* Poll fresh state */
     pad_poll_backend();
@@ -1076,26 +1157,104 @@ skip_inject: ;
       } }
 
     /* Analog sticks */
-    /* PAD_STICK="lx,ly,rx,ry" (0-255, 128 = centred): hold the analog sticks at
-     * fixed positions. Rubber Ducky drives its camera from the sticks and never
-     * moves on its own, so with no host pad the view is frozen wherever it
-     * started -- which can leave the subject of the demo off-screen or too far
-     * away to make out. Legit input simulation, same footing as YDKJ_INJECT_PAD. */
+    /* PAD_STICK="lx,ly,rx,ry[,from,until]"
+     *   Fields 1..4 (required): stick axes in [0..255] (128 = center, 0 = left/up, 255 = right/down).
+     *   Fields 5..6 (optional): hold window [from, until) in wall-clock seconds, or guest flips when
+     *     PAD_CLOCK=flips. Note: numbers > 255 in fields 5..6 (e.g. "128,255,128,255,190,260") are
+     *     time bounds (190s..260s), NOT axis values. Out-of-range axis values (< 0 or > 255) or
+     *     malformed specs are rejected loudly to stderr instead of truncating via (unsigned char). */
     { static int s_st = -1;
       static unsigned char s_v[4] = {128,128,128,128};
