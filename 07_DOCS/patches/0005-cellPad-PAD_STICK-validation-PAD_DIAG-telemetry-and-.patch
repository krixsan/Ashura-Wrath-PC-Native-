-      if (s_st && pad_clock(s_t0) >= s_from && pad_clock(s_t0) < s_until) { hs->analog_lx = s_v[0]; hs->analog_ly = s_v[1];
-                  hs->analog_rx = s_v[2]; hs->analog_ry = s_v[3];
-                  hs->connected = 1; }
+      if (s_st < 0) {
+          const char* e = getenv("PAD_STICK");
+          s_st = 0;
+          if (e) {
+              while (*e == ' ' || *e == '\t') e++;
+              if (!*e) {
+                  fprintf(stderr, "[cellPad] ERROR: PAD_STICK is empty; expected \"lx,ly,rx,ry[,from,until]\" (axes 0..255)\n");
+              } else {
+                  const char* p = e;
+                  int axes[4] = {128, 128, 128, 128};
+                  double bounds[2] = {0.0, 1e30};
+                  int ok = 1;
+                  for (int idx = 0; idx < 4; idx++) {
+                      char* endp = NULL;
+                      long val = strtol(p, &endp, 10);
+                      if (endp == p) { ok = 0; break; }
+                      while (*endp == ' ' || *endp == '\t') endp++;
+                      if (idx < 3) {
+                          if (*endp != ',') { ok = 0; break; }
+                          p = endp + 1;
+                      } else {
+                          p = endp;
+                      }
+                      if (val < 0 || val > 255) {
+                          fprintf(stderr,
+                                  "[cellPad] ERROR: PAD_STICK=\"%s\" field %d value %ld out of range [0..255] -- rejecting PAD_STICK\n",
+                                  e, idx + 1, val);
+                          ok = -1;
+                          break;
+                      }
+                      axes[idx] = (int)val;
+                  }
+                  if (ok == 1 && *p != '\0') {
+                      if (*p != ',') {
+                          ok = 0;
+                      } else {
+                          p++;
+                          for (int bidx = 0; bidx < 2; bidx++) {
+                              char* endp = NULL;
+                              double dv = strtod(p, &endp);
+                              if (endp == p || !(dv == dv) || dv < 0.0 || dv > 1e30) { ok = 0; break; }
+                              bounds[bidx] = dv;
+                              while (*endp == ' ' || *endp == '\t') endp++;
+                              if (bidx == 0 && *endp == ',') {
+                                  p = endp + 1;
+                                  continue;
+                              }
+                              if (*endp != '\0') { ok = 0; break; }
+                              p = endp;
+                              break;
+                          }
+                      }
+                  }
+                  if (ok == 1 && bounds[1] <= bounds[0]) {
+                      fprintf(stderr,
+                              "[cellPad] ERROR: PAD_STICK=\"%s\" invalid time window [%.3f, %.3f) (until must be > from) -- rejecting\n",
+                              e, bounds[0], bounds[1]);
+                      ok = -1;
+                  }
+                  if (ok == 0) {
+                      fprintf(stderr,
+                              "[cellPad] ERROR: PAD_STICK=\"%s\" malformed; expected \"lx,ly,rx,ry[,from,until]\" (axes 0..255)\n",
+                              e);
+                  } else if (ok == 1) {
+                      s_v[0] = (unsigned char)axes[0];
+                      s_v[1] = (unsigned char)axes[1];
+                      s_v[2] = (unsigned char)axes[2];
+                      s_v[3] = (unsigned char)axes[3];
+                      s_from = bounds[0];
+                      s_until = bounds[1];
+                      s_st = 1;
+                      const char* clk = getenv("PAD_CLOCK");
+                      fprintf(stderr,
+                              "[cellPad] PAD_STICK armed: L=(%u,%u) R=(%u,%u) window=[%.3f, %.3f) (%s)\n",
+                              s_v[0], s_v[1], s_v[2], s_v[3], s_from, s_until,
+                              (clk && !strcmp(clk, "flips")) ? "flips" : "sec");
+                      fflush(stderr);
+                  }
+              }
+          }
+      }
+      if (s_st && port_no == 0 && pad_clock(s_t0) >= s_from && pad_clock(s_t0) < s_until) {
+          hs->analog_lx = s_v[0]; hs->analog_ly = s_v[1];
+          hs->analog_rx = s_v[2]; hs->analog_ry = s_v[3];
+          hs->connected = 1;
+          diag_src_tag = 1;
+      }
       /* PAD_SWEEP=<seconds per step>: walk the sticks through a fixed set of
        * deflections instead of holding one. Guessing a single stick position and
        * re-running costs ~5 minutes a try; a sweep answers "can input move the
@@ -1118,6 +1277,7 @@ skip_inject: ;
             hs->analog_lx = steps[k][0]; hs->analog_ly = steps[k][1];
             hs->analog_rx = steps[k][2]; hs->analog_ry = steps[k][3];
             hs->connected = 1;
+            diag_src_tag = 2;
             { static int lastk = -1;
               if (k != lastk) { lastk = k;
                 fprintf(stderr, "[PADSWEEP] step %d: l=(%u,%u) r=(%u,%u)%c", k,
@@ -1201,6 +1361,84 @@ emit:
      * attack firing once.
      *
      * PAD_ALWAYS_CHANGE=1 restores the old always-a-packet behaviour. */
+    {
+        int dlvl = pad_diag_level();
+        if (dlvl > 0) {
+            unsigned long long now_ms = GetTickCount64();
+            double rel_s = (double)(now_ms - s_diag_t0_ms) / 1000.0;
+            u32 flip = cellGcm_flip_request_count();
+            u16 hdr = data->button[1];
