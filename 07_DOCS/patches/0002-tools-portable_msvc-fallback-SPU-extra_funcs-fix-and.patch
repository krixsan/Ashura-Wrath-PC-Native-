+def test_synth_lwzx_index_reused_before_bctr():
+    """64-bit synthesized lwzx where rIdx is mutated by `add` and overwritten
+    with the table base before `bctr`:
+
+        cmplwi r0, 299 ; lwz r0, 0x34(r31) ; slwi r9, r0, 2 ; lwz r0, 16(r2)
+        add r9, r9, r0 ; lwz r0, 0(r9) ; lwz r9, 16(r2) ; add r0, r0, r9
+        mtctr r0 ; bctr
+
+    Scanning backward from bctr saw `lwz r9, 16(r2)` (or `add r9, r9, r0`) before
+    `slwi r9, r0, 2`, failed to recover `_raw_idx = r0`, fell back to 256 entries,
+    and truncated the switch table (Asura's Wrath func_00CD65CC).
+    """
+    n, table = 300, 0x11000
+    first = table + 4 * n
+    mem = {TOC + 16: table}
+    for k in range(n):
+        mem[table + 4 * k] = first + 4 * k - table
+    words = [w_cmplwi(0, 0, n - 1), w_lwz(0, 31, 0x34), w_slwi(9, 0, 2),
+             w_lwz(0, 2, 16), w_add(9, 9, 0), w_lwz(0, 9, 0), w_lwz(9, 2, 16),
+             w_add(0, 0, 9), w_mtctr(0), w_bctr()]
+    check("synth lwzx with index register reused before bctr (>256 cases)",
+          discover(words, mem), [first + 4 * k for k in range(n)])
+
+
